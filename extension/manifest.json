{
  "manifest_version": 3,
  "name": "Liked Music Exporter",
  "version": "1.0",
  "description": "Turn your YouTube Music liked songs into a public, shareable playlist in one click. Copies the link and opens it.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Liked Music Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
